{
  "id": "app.nous.dawn-comic-downloader",
  "name": "破晓漫画下载器",
  "description": "DawnComicDownloader：六个图库站点的文字与图片检索、带元信息的结果列表，以及按编号归档的下载队列。",
  "version": "1.0.1",
  "api": "1.3",
  "requiresHost": "1.2.0",
  "author": {
    "name": "Nelson",
    "url": "https://github.com/liveldy"
  },
  "platforms": [
    "windows-x64"
  ],
  "permissions": [
    "storage",
    "native.runtime"
  ],
  "entry": "ui/index.html",
  "repository": "liveldy/DawnComicDownloader",
  "license": "MIT",
  "icon": "data:image/svg+xml;base64,",
  "navigation": [
    {
      "id": "search",
      "label": "检索",
      "icon": "search"
    },
    {
      "id": "settings",
      "label": "设置",
      "icon": "settings"
    }
  ],
  "defaultView": "search",
  "requiredMethods": [
    "runtime.start",
    "runtime.invoke",
    "storage.get",
    "storage.set"
  ],
  "optionalMethods": [
    "storage.remove"
  ],
  "resources": [
    "ui/index.html",
    "ui/style.css",
    "ui/app.js",
    "ui/engine.js",
    "ui/nous-plugin.js",
    "ui/fonts/archivo-latin.woff2",
    "ui/fonts/OFL.txt"
  ],
  "runtime": {
    "windows-x64": {
      "type": "jvm",
      "entry": "app.dawncomic.PluginMain",
      "mainJar": "app/plugin.jar",
      "asset": {
        "url": "https://github.com/liveldy/DawnComicDownloader/releases/download/v1.0.1/DawnComicDownloader-windows-x64.module.zip",
        "sha256": "ee5e4d8218d95d673c60ae536b4936e7cd85a672ef95a6d5dbf3f4b11fbd29cf",
        "bytes": 16655559
      }
    }
  },
  "changelog": [
    {
      "version": "1.0.1",
      "publishedAt": "2026-11-14",
      "changes": [
        "标题位改为 DCD（DawnComicDownloader）。",
        "结果区新增按来源过滤：一行站点名与计数，点击只看该站，再点回到全部；底部站点条仍控制哪些站参与下一次检索。",
        "深色主题重新配色：地面为暖炭色而非反相，卡片用提亮一档的面色替代阴影，朱色拆成标注用（#E8653F）与实心按钮用（#B8431F）两支，并声明 color-scheme 让原生控件跟随。",
        "下载每页最多重试 3 次，失败先删掉 .part 再重来；超时放宽到 180 秒以适配视频。"
      ]
    },
    {
      "version": "1.0.0",
      "publishedAt": "2026-11-14",
      "changes": [
        "六个来源接入：Xpicvid（帝国 CMS 检索 + 阅读器顺序出图）、Ahri Gallery（列表与 IMAGE_SERVER 阅读器）、禁漫天堂（Cloudflare 质询后走 cf_clearance）、HentaiLeague（wp-json）、Rule34（Gelbooru 0.1.11 页面）、Rule34Video（KVS flashvars 选最高画质）。",
        "文字检索按来源并行，图片检索先经 SauceNAO（可选 key）或 IQDB 认出作品，再把标题、作者、作品名回灌到六站。",
        "下载队列按编号建目录，页序三位编号；封面经原生模块取回 data URL 显示，页面本身不出网。"
      ]
    }
  ]
}